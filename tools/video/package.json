{
  "name": "break-the-wall-demo-video",
  "version": "1.0.0",
  "description": "Cuts the screen recording of a session into Break the Wall's launch video and the README's GIF, with Remotion.",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.547",
    "@remotion/google-fonts": "4.0.547",
    "@remotion/media": "4.0.547",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.547"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.547",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.15.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "proxy": "node scripts/proxy.mjs",
    "check:token": "node scripts/check-token.mjs",
    "render:linkedin": "remotion render src/index.ts LinkedIn out/break-the-wall-linkedin.mp4 --codec=h264 --crf=18",
    "render:readme": "node scripts/readme-media.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
